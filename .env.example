# Copia aquest fitxer a .env.local i omple els valors. No el pugis mai a GitHub.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clau de servei: només servidor. A Vercel, marca-la com a "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: Id. del directori (inquilí) de Microsoft de Grup Nordest. Si s'omple, només
# entren comptes d'aquest directori. Activa-ho després de comprovar que l'inici de sessió funciona.
AZURE_TENANT_ID=

# Correus que es converteixen en administradors el primer cop que entren (separats per comes)
ADMIN_EMAILS=roger.sabate@grupnordest.com

# Correu a la corredoria (Microsoft Graph, permís d'aplicació Mail.Send). AZURE_TENANT_ID és obligatori per al correu.
# Mai enganxis el secret en un xat ni el pugis a GitHub: només a .env.local i a Vercel ("Sensitive").
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
CORREU_REMITENT=assegurances@grupnordest.com
CORREU_GESTOR_PRINCIPAL=yago@msocis.com
# Es poden posar diverses adreces separades per comes.
CORREU_GESTOR_SUPLENT=ribas@msocis.com
CORREU_COPIA_ADMIN=assegurances@grupnordest.com
CORREU_SIGNATURA=Nuri
# Mode de proves: si té valor, TOTS els correus van només aquí (la corredoria no rep res).
CORREU_PROVES=
